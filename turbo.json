{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "apps/**/*.ts",
        "libs/**/*.ts",
        "prisma/**/*.prisma",
        "tsconfig*.json"
      ],
      "outputs": ["dist/**"]
    },
    "prebuild": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "inputs": ["prisma/**/*.prisma"],
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "prisma:migrate": {
      "cache": false
    }
  }
}
