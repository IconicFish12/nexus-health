{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "apps/**/*.ts",
        "libs/**/*.ts",
        "prisma/**/*.prisma",
        "tsconfig*.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "format": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "prebuild": {
      "outputs": []
    },
    "prisma:generate": {
      "inputs": [
        "prisma/**/*.prisma"
      ],
      "outputs": [
        "node_modules/.prisma/client/**"
      ]
    },
    "prisma:migrate": {
      "cache": false
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "ui": "tui"
}