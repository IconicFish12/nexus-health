{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "builder": "swc",
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
    "options": {
      "swcrcPath": "./.swcrc"
    },
    "typeCheck": true
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "appointment-service": {
      "type": "application",
      "root": "apps/appointment-service",
      "entryFile": "main",
      "sourceRoot": "apps/appointment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/appointment-service/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "billing-service": {
      "type": "application",
      "root": "apps/billing-service",
      "entryFile": "main",
      "sourceRoot": "apps/billing-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/billing-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "emr-service": {
      "type": "application",
      "root": "apps/emr-service",
      "entryFile": "main",
      "sourceRoot": "apps/emr-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/emr-service/tsconfig.app.json"
      }
    },
    "inventory-service": {
      "type": "application",
      "root": "apps/inventory-service",
      "entryFile": "main",
      "sourceRoot": "apps/inventory-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/inventory-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "pharmacy-service": {
      "type": "application",
      "root": "apps/pharmacy-service",
      "entryFile": "main",
      "sourceRoot": "apps/pharmacy-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pharmacy-service/tsconfig.app.json"
      }
    },
    "protobuf": {
      "type": "library",
      "root": "libs/protobuf",
      "entryFile": "index",
      "sourceRoot": "libs/protobuf/src",
      "compilerOptions": {
        "tsConfigPath": "libs/protobuf/tsconfig.lib.json"
      }
    },
    "staff-service": {
      "type": "application",
      "root": "apps/staff-service",
      "entryFile": "main",
      "sourceRoot": "apps/staff-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/staff-service/tsconfig.app.json"
      }
    },
    "ward-service": {
      "type": "application",
      "root": "apps/ward-service",
      "entryFile": "main",
      "sourceRoot": "apps/ward-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ward-service/tsconfig.app.json"
      }
    }
  }
}
